package-as: ForeverForge_Druid

# The packager runs from the repository root (-m this file) so the git tag
# still supplies @project-version@. Everything except this addon is ignored,
# then this folder is lifted to the zip root.
move-folders:
  ForeverForge_Druid/ForeverForge_Druid: ForeverForge_Druid

ignore:
  - CHANGELOG.md
  - Core.lua
  - CURSEFORGE.md
  - docs
  - ForeverForge.toc
  - LICENSE
  - Marketing-Brief.md
  - Menu.lua
  - Minimap.lua
  - Modules
  - README.md
  - Screenshots
  - Textures
  - work-orders
